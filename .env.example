# Active AI Model Keys for OdinAI (Hugging Face is the default/preferred provider)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Shared secret for verifying `terra-signature` HMAC-SHA256 headers on
# POST /api/webhooks/terra. If unset, signature verification is skipped
# (local/dev use only) — always set this in any deployed environment.
TERRA_SIGNING_SECRET=your_terra_webhook_signing_secret_here
