# Active AI Model Keys for OdinAI (Hugging Face is the default/preferred provider)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Shared secret for verifying `terra-signature` HMAC-SHA256 headers on
# POST /api/webhooks/terra. If unset, signature verification is skipped
# (local/dev use only) — always set this in any deployed environment.
TERRA_SIGNING_SECRET=your_terra_webhook_signing_secret_here

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to localhost:3000 for local dev. In production, set this to your
# deployed frontend's exact origin (e.g. https://your-app.vercel.app) — the
# frontend calls this API's absolute URL directly, so CORS must allow it.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
